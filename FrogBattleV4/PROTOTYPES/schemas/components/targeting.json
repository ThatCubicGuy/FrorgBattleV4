{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "${SCHEMAS_BASE_DIR}/components/targeting.json",
  "title": "Targeting component",
  "description": "A component that selects targets for shards.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "filter",
        "blast",
        "bounce",
        "area_of_effect"
      ]
    }
  },
  "required": ["type"],
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "filter"
        }
      },
      "$ref": "${SCHEMAS_BASE_DIR}/components/targeting/filter.json"
    },
    {
      "properties": {
        "type": {
          "const": "blast"
        }
      },
      "$ref": "${SCHEMAS_BASE_DIR}/components/targeting/blast.json"
    },
    {
      "properties": {
        "type": {
          "const": "bounce"
        }
      },
      "$ref": "${SCHEMAS_BASE_DIR}/components/targeting/bounce.json"
    },
    {
      "properties": {
        "type": {
          "const": "area_of_effect"
        }
      },
      "$ref": "${SCHEMAS_BASE_DIR}/components/targeting/area-of-effect.json"
    }
  ]
}