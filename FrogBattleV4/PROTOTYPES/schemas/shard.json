{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "${SCHEMAS_BASE_DIR}/shard.json",
  "title": "Ability",
  "description": "An ability shard for a character to use in battle.",
  "type": "object",
  "required": ["name", "description", "type"],
  "properties": {
    "requirements": {
      "$ref": "${SCHEMAS_BASE_DIR}/shards/requirements.json"
    },
    "name": {
      "description": "Name of the shard.",
      "$ref": "${SCHEMAS_BASE_DIR}/text-translatable.json"
    },
    "description": {
      "description": "Description of what the shard does.",
      "$ref": "${SCHEMAS_BASE_DIR}/text-translatable.json"
    },
    "type": {
      "description": "Type of the shard. One of \"target\", \"empower\", \"affect\".",
      "type": "string",
      "enum": [
        "target",
        "empower",
        "affect"
      ]
    }
  },
  "$comment": "Switch based on shard type that determines which schema to reference.",
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "target"
        }
      },
      "$ref": "${SCHEMAS_BASE_DIR}/shards/target-shard.json"
    },
    {
      "properties": {
        "type": {
          "const": "empower"
        }
      },
      "$ref": "${SCHEMAS_BASE_DIR}/shards/empower-shard.json"
    },
    {
      "properties": {
        "type": {
          "const": "affect"
        }
      },
      "$ref": "${SCHEMAS_BASE_DIR}/shards/affect-shard.json"
    }
  ]
}